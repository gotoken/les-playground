# 遅延評価による動的計画法：表が自分自身を参照する（Haskell の遅延配列と同じ流儀）
# 最長共通部分列 (LCS) を、埋める順番を書かずに求める

# (f(0), f(1), ..., f(n-1))。各要素は使われるまで計算されず、計算は1回だけ
# （ループで組み立てる。要素は遅延のままで、組み立てに深い再帰は要らない）
def tabulate[T](n: Int, f: (Int) -> T) -> (T, ...):
    acc: (T, ...) = ()
    i = 0
    for i < n:
        acc = acc << f(i)
        i = i + 1
    acc

def max(a: Int, b: Int) -> Int: a > b ? a : b

# t[i][j] = a の先頭 i 文字と b の先頭 j 文字の LCS の長さ
# verbose のときは、計算されたセルの座標を表示する
def lcs_table(a: String, b: String, verbose: Bool) -> ((Int, ...), ...):
    def cell(i: Int, j: Int) -> Int:
        if verbose:
            print "(", i, ",", j, ") "
        if i == 0 || j == 0:
            0
        else:
            if a[i - 1] == b[j - 1]:
                t[i - 1][j - 1] + 1                 # 定義中の表 t 自身を引く
            else:
                max(t[i - 1][j], t[i][j - 1])
    t = tabulate(a.Len() + 1, |i|: tabulate(b.Len() + 1, |j|: cell(i, j)))
    t

# a と b を揃えた2行を作る（共通部分列の文字は縦に揃い、ほかは - で埋める）
# たどる前に、表のセルを行ごとに順に評価しておく。遅延評価の言語では本来これは要らない
# （最初の参照が、依存するセルを引き出してくれる）。ここでやるのは、この処理系がブラウザの
# スタックで再帰するため、依存するセルの連鎖が長いと一部のブラウザ（iOS Safari）で溢れるから。
# 右下からたどる処理がループなのも同じ理由。
def align(a: String, b: String) -> (String, String):
    n = a.Len()
    m = b.Len()
    t = lcs_table(a, b, false)
    i = 0
    for i <= n:
        j = 0
        for j <= m:
            _ = t[i][j]!
            j = j + 1
        i = i + 1
    x = ""
    y = ""
    i = n
    j = m
    for i > 0 || j > 0:
        if i > 0 && j > 0 && a[i - 1] == b[j - 1]:
            x = a[i - 1] + x
            y = b[j - 1] + y
            i = i - 1
            j = j - 1
        else:
            if j == 0 || (i > 0 && t[i - 1][j] >= t[i][j - 1]):
                x = a[i - 1] + x
                y = "-" + y
                i = i - 1
            else:
                x = "-" + x
                y = b[j - 1] + y
                j = j - 1
    (x, y)

def show(a: String, b: String):
    (x, y) = align(a, b)
    print x, "\n", y, "\n\n"

# 1. 似た2文
show("lazy evaluation computes a value only when needed", "lazy evaluation computes each value once, when first needed")

# 2. DNA 配列（教科書でおなじみの組）
show("ACCGGTCGAGTGCGCGGAAGCCGGCCGAA", "GTCGTTCGGAATGCCGTTGCTCTGTAAA")

# 3. 実際に計算されたセルだけを表示する：似た文字列ほど、表の一部しか計算されない
def count_cells(a: String, b: String):
    t = lcs_table(a, b, true)
    print "\"", a, "\" と \"", b, "\"（表は ", (a.Len() + 1) * (b.Len() + 1), " セル）\n  計算されたセル: "
    n = t[a.Len()][b.Len()]!
    print "\n  LCS の長さ = ", n, "\n\n"

count_cells("lazy", "lazy")
count_cells("lazy", "hazy")
count_cells("abc", "xyz")
