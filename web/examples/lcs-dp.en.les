# Dynamic programming by lazy evaluation: the table refers to itself (as with Haskell's lazy arrays)
# Longest common subsequence (LCS), without spelling out the order to fill the table in

# (f(0), f(1), ..., f(n-1)). Each element is not computed until used, and only once
def tabulate[T](n: Int, f: (Int) -> T) -> (T, ...):
    def from(i: Int) -> (T, ...):
        i == n ? () : (f(i), ...from(i + 1))
    from(0)

def max(a: Int, b: Int) -> Int: a > b ? a : b

# t[i][j] = length of the LCS of the first i characters of a and the first j of b
def lcs_table(a: String, b: String) -> ((Int, ...), ...):
    def cell(i: Int, j: Int) -> Int:
        if i == 0 || j == 0:
            0
        else:
            if a[i - 1] == b[j - 1]:
                t[i - 1][j - 1] + 1                 # look up t, the table being defined
            else:
                max(t[i - 1][j], t[i][j - 1])
    t = tabulate(a.Len() + 1, |i|: tabulate(b.Len() + 1, |j|: cell(i, j)))
    t

# Walk back from the bottom-right corner of the table to get the LCS itself
def lcs(a: String, b: String) -> String:
    t = lcs_table(a, b)
    def back(i: Int, j: Int) -> String:
        if i == 0 || j == 0:
            ""
        else:
            if a[i - 1] == b[j - 1]:
                back(i - 1, j - 1) + a[i - 1]
            else:
                t[i - 1][j] >= t[i][j - 1] ? back(i - 1, j) : back(i, j - 1)
    back(a.Len(), b.Len())

a = "the quick brown fox jumps over the lazy dog"
b = "pack my box with five dozen liquor jugs"
t = lcs_table(a, b)
print "a = ", a, "\n"
print "b = ", b, "\n"
print "LCS length = ", t[a.Len()][b.Len()], "\n"
print "LCS = \"", lcs(a, b), "\"\n"
