# Dynamic programming by lazy evaluation: the table refers to itself (as with Haskell's lazy arrays)
# Longest common subsequence (LCS), without spelling out the order to fill the table in

# (f(0), f(1), ..., f(n-1)). Each element is not computed until used, and only once
def tabulate[T](n: Int, f: (Int) -> T) -> (T, ...):
    def from(i: Int) -> (T, ...):
        i == n ? () : (f(i), ...from(i + 1))
    from(0)

def max(a: Int, b: Int) -> Int: a > b ? a : b

# t[i][j] = length of the LCS of the first i characters of a and the first j of b
# When verbose, print the coordinates of each cell as it is computed
def lcs_table(a: String, b: String, verbose: Bool) -> ((Int, ...), ...):
    def cell(i: Int, j: Int) -> Int:
        if verbose:
            print "(", i, ",", j, ") "
        if i == 0 || j == 0:
            0
        else:
            if a[i - 1] == b[j - 1]:
                t[i - 1][j - 1] + 1                 # look up t, the table being defined
            else:
                max(t[i - 1][j], t[i][j - 1])
    t = tabulate(a.Len() + 1, |i|: tabulate(b.Len() + 1, |j|: cell(i, j)))
    t

# Line a and b up in two rows (characters of the common subsequence line up vertically; the rest are padded with -)
# Walk back from the bottom-right corner of the table, building the two rows, the | marks and the LCS together
# (matches are told apart from padding here, so a literal - in the input is handled correctly)
def align(a: String, b: String) -> (String, String, String, String):
    t = lcs_table(a, b, false)
    def back(i: Int, j: Int) -> (String, String, String, String):
        if i == 0 && j == 0:
            ("", "", "", "")
        else:
            if i > 0 && j > 0 && a[i - 1] == b[j - 1]:
                (x, y, m, c) = back(i - 1, j - 1)
                (x + a[i - 1], y + b[j - 1], m + "|", c + a[i - 1])
            else:
                if j == 0 || (i > 0 && t[i - 1][j] >= t[i][j - 1]):
                    (x, y, m, c) = back(i - 1, j)
                    (x + a[i - 1], y + "-", m + " ", c)
                else:
                    (x, y, m, c) = back(i, j - 1)
                    (x + "-", y + b[j - 1], m + " ", c)
    back(a.Len(), b.Len())

def show(a: String, b: String):
    (x, y, marks, common) = align(a, b)
    print x, "\n", marks, "\n", y, "\n"
    print "LCS length = ", common.Len(), "\n"
    print "LCS        = \"", common, "\"\n\n"

# The demos are ordered by how deep the recursion gets (about the sum of the two lengths). The interpreter recurses
# on the browser's own stack, so on a browser with a small stack (iOS Safari) the later, longer ones may crash
# while the earlier ones still run.

# 1. Print only the cells that actually get computed: the more alike the strings, the less of the table is computed
def count_cells(a: String, b: String):
    t = lcs_table(a, b, true)
    print "\"", a, "\" and \"", b, "\" (the table has ", (a.Len() + 1) * (b.Len() + 1), " cells)\n  computed cells: "
    n = t[a.Len()][b.Len()]!
    print "\n  LCS length = ", n, "\n\n"

count_cells("lazy", "lazy")
count_cells("lazy", "hazy")
count_cells("abc", "xyz")

# 2. DNA sequences (a pair familiar from textbooks)
show("ACCGGTCGAGTGCGCGGAAGCCGGCCGAA", "GTCGTTCGGAATGCCGTTGCTCTGTAAA")

# 3. Two similar sentences
show("lazy evaluation computes a value only when needed", "lazy evaluation computes each value once, when first needed")
